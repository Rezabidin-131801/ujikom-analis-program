# Salin menjadi .env lalu isi nilainya. JANGAN commit/unggah file .env asli.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[masukkan password anda]
POSTGRES_DB=[masukkan nama database anda]

DATABASE_URL=postgresql://postgres:[masukkan password anda]@localhost:5432/[masukkan nama database anda]

AUTH_SECRET=[generate minimal 32 karakter acak]
BETTER_AUTH_URL=http://localhost:3000

ACC_PASSWORD=[masukkan password untuk seluruh akun demo]